{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:next",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting|ready - started server|> next dev|Compiling",
          "endsPattern": "Ready in|started server on|Local:\\s*http://localhost:"
        }
      },
      "options": {
        "env": {
          "PORT": "3000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
