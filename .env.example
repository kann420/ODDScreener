## Opinion OpenAPI
# Docs: https://docs.opinion.trade/developer-guide/opinion-open-api/overview
# IMPORTANT: never commit your real key.

# Server-side only - NEVER use NEXT_PUBLIC_ prefix for API keys
OPINION_API_KEY=

# Optional (defaults to Opinion proxy)
OPINION_BASE_URL=https://proxy.opinion.trade:8443/openapi

# Optional: Database paths (defaults to ./data/)
# SMART_MONEY_DB_PATH=./data/smartmoney.sqlite
# RECENT_TRADES_DB_PATH=./data/recenttrades.sqlite

## Turso Database (for access codes - shared between local & production)
# Create free account: https://turso.tech
# 1. Install CLI: curl -sSfL https://get.turso.sh | bash
# 2. Login: turso auth login
# 3. Create database: turso db create oddscreener-access
# 4. Get URL: turso db show oddscreener-access --url
# 5. Get token: turso db tokens create oddscreener-access
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

## Admin secret for access code management (use a strong random value)
ADMIN_SECRET=change_me_to_a_strong_random_secret

## Optional but recommended: separate secret for signed arbitrage session cookies
ARBITRAGE_SESSION_SECRET=change_me_to_a_second_strong_random_secret

## Predict.fun API (for arbitrage cross-platform matching)
# Docs: https://dev.predict.fun/ | https://docs.predict.fun/
# Server-side only - NEVER use NEXT_PUBLIC_ prefix for API keys
PREDICTFUN_API_KEY=
# Optional (defaults to mainnet)
# PREDICTFUN_BASE_URL=https://api.predict.fun
# Contact form mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SENDER_NAME=ODDScreeners Contact
CONTACT_RECIPIENT=
