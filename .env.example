## Opinion OpenAPI
# Docs: https://docs.opinion.trade/developer-guide/opinion-open-api/overview
# IMPORTANT: never commit your real key.

# Server-side only - NEVER use NEXT_PUBLIC_ prefix for API keys
OPINION_API_KEY=

# Optional (defaults to Opinion proxy)
OPINION_BASE_URL=https://proxy.opinion.trade:8443/openapi

# Optional: Database paths (defaults to ./data/)
# SMART_MONEY_DB_PATH=./data/smartmoney.sqlite
# RECENT_TRADES_DB_PATH=./data/recenttrades.sqlite
